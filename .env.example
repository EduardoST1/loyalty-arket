# Arket Loyalty. Usa un entorno y una base de datos independientes.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TENANT_SLUG="arket-studio"
NEXT_PUBLIC_BRAND_NAME="Arket Studio"
NEXT_PUBLIC_CLUB_NAME="Arket Loyalty"
NEXT_PUBLIC_BRAND_TAGLINE="Acumula sellos y canjea recompensas"
NEXT_PUBLIC_LOGO_PATH="/arket-piloto.svg"
NEXT_PUBLIC_PRIMARY_COLOR="#203044"
NEXT_PUBLIC_SECONDARY_COLOR="#FFFFFF"
NEXT_PUBLIC_STAMP_GOAL="6"
NEXT_PUBLIC_STAMP_REWARD="Recompensa de lealtad"

DATABASE_URL="mysql://usuario:contraseña@127.0.0.1:3306/arket_loyalty"
# Genera dos secretos distintos y un PIN numérico de al menos ocho dígitos.
CUSTOMER_SESSION_SECRET=""
BARISTA_SESSION_SECRET=""
BARISTA_PIN=""

# Contraseña exclusiva del panel /admin, mínimo 20 caracteres.
ARKET_ADMIN_PASSWORD=""

# Configura solo el emisor de Arket.
GOOGLE_WALLET_CLASS_MODE="prepared"
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_LOYALTY_CLASS_ID="arket_studio_loyalty"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=""
# Alternativa local: GOOGLE_SERVICE_ACCOUNT_KEY_PATH="./certificates/google-wallet-credentials.json"
